# Copy to .env and fill in your key. Never commit .env.

# --- OpenAI ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-5.1                          # LLM for hybrid corpus prose
OPENAI_REASONING_EFFORT=low                   # none | low | medium | high (low is ~8x faster than high)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small # embedding model for the vector stores

# --- Pre-RAG ingestion (scripts/ingest_vector_stores.py) ---
VECTORSTORE_DIR=data/vectorstores             # parent folder of the two Chroma databases
HR_COLLECTION_NAME=hr_policies                # also the HR database folder name
PRODUCT_COLLECTION_NAME=product_manuals       # also the product database folder name
HR_CHUNK_SIZE=800                             # characters per chunk, HR policies
HR_CHUNK_OVERLAP=120
PRODUCT_CHUNK_SIZE=1200                       # characters per chunk, product manuals
PRODUCT_CHUNK_OVERLAP=200
INGEST_BATCH_SIZE=4                           # PDFs prepared and embedded in parallel
EMBEDDING_BATCH_SIZE=100                      # chunks per embeddings request and per Chroma write
STRIP_HEADERS_FOOTERS=true                    # remove repeated page headers/footers before chunking
VALIDATION_SAMPLE_SIZE=3                      # sample records shown by scripts/validate_vector_stores.py
